{
  "name": "project-documentation",
  "version": "0.1.0",
  "description": "Dynamic project documentation server for rendering Markdown content and serving OpenAPI/Swagger specifications with integrated HTML documentation pages.",
  "keywords": [
    "project",
    "documentation",
    "swagger",
    "redoc"
  ],
  "license": "MIT",
  "author": "Leandro Senni",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "project-documentation": "bin/project-documentation.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/project-documentation.js docs/",
    "test": "vitest run"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "swagger-ui-dist": "^5.20.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
