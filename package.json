{
  "name": "@leandrose/project-documentation",
  "version": "0.2.0",
  "description": "Dynamic project documentation server for rendering Markdown content and serving OpenAPI/Swagger specifications with integrated HTML documentation pages.",
  "keywords": [
    "project",
    "documentation",
    "swagger",
    "redoc"
  ],
  "license": "MIT",
  "author": "Leandro Senni",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "project-documentation": "bin/project-documentation.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/project-documentation.js docs/",
    "test": "vitest run"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@asyncapi/generator": "^3.2.1",
    "@asyncapi/html-template": "^3.5.6",
    "express": "^5.2.1",
    "marked": "^18.0.5",
    "npm-check-updates": "^22.2.2",
    "plantuml-encoder": "^1.4.0",
    "swagger-ui-dist": "^5.32.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
